module

public import AffineCurveCounting.PlaneProjectionDegree
public import AffineCurveCounting.SharpPlaneCount

/-! Complete the prime-ideal interface in ambient dimension two. Every prime
ideal with positive affine Hilbert degree is generated by an irreducible plane
equation of exactly that degree, so the proved plane count applies. -/

@[expose] public section
namespace AffineCurveCounting
noncomputable section
open MvPolynomial

theorem exists_plane_ideal_equation {K : Type*} [Field K]
    (I : Ideal (MvPolynomial (Fin 2) K)) [I.IsPrime] (d : ℕ) (hd : 0 < d)
    (hdegree : ∃ N : ℕ, ∃ c : ℤ, ∀ n ≥ N,
      (Module.finrank K (filteredCoordinateSpace I n) : ℤ) = (d : ℤ) * n + c) :
    ∃ f : MvPolynomial (Fin 2) K, Irreducible f ∧ I = Ideal.span {f} ∧ f.totalDegree = d := by
  obtain ⟨j, hj⟩ := affine_degree_has_transcendental_coordinate I d hd hdegree
  obtain ⟨f, hf, hker⟩ := exists_plane_projection_equation I X (fun i => by simp) d hdegree j hj
  have hid : RingHom.ker (projectionCoordinateMap I X) = I := by
    ext g
    change (Ideal.Quotient.mk I) (aeval X g) = 0 ↔ g ∈ I
    rw [aeval_X_left_apply, Ideal.Quotient.eq_zero_iff_mem]
  have hI : I = Ideal.span {f} := hid.symm.trans hker
  refine ⟨f, hf, hI, ?_⟩
  have hp : ∃ N : ℕ, ∃ c : ℤ, ∀ n ≥ N,
      (Module.finrank K (filteredCoordinateSpace I n) : ℤ) = (f.totalDegree : ℤ) * n + c := by
    rw [hI]
    exact ⟨f.totalDegree, (f.totalDegree : ℤ) - f.totalDegree.choose 2,
      fun M hM => principal_plane_hilbert_function f hf.ne_zero hM⟩
  exact Nat.le_antisymm
    (eventual_linear_slope_le _ _ f.totalDegree d hp hdegree (fun _ => le_rfl))
    (eventual_linear_slope_le _ _ d f.totalDegree hdegree hp (fun _ => le_rfl))

/-- The n=2 instance of the full ideal/Hilbert-degree counting interface is
unconditional, with one constant independent of the ideal and degree. -/
theorem affineCurveBound_dimension_two :
    ∃ C : ℝ, 0 < C ∧ ∀ I : Ideal (CoordinatePolynomial 2), I.IsPrime →
      ∀ d : ℕ, 0 < d → HasAffineCurveDegree I d →
        ∀ B : ℝ, 1 ≤ B → (count (idealZeroLocus I) B : ℝ) ≤ C * curveBound d B := by
  obtain ⟨C, hC, hcount⟩ := planeCurveBound
  refine ⟨C, hC, ?_⟩
  intro I hI d hd hdegree B hB
  let : I.IsPrime := hI
  obtain ⟨f, hf, hIf, hfd⟩ := exists_plane_ideal_equation I d hd hdegree
  rw [hIf, idealZeroLocus_span_singleton, ← hfd]
  exact hcount f hf (hfd.symm ▸ hd) B hB

end
end AffineCurveCounting
