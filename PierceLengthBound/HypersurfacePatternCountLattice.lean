module

public import PierceLengthBound.HypersurfacePatternCountWeights

/-!
# Cross-congruence lattices and their normal vectors

For a triple primitive modulo `n`, the congruence `u × v = 0 mod n` is equivalent to
`v ∈ ℤu + nℤ³`. For two independent vectors in this lattice, their cross product divided by
`n` is a nonzero vector in the normal congruence lattice. Consequently the product of their
lengths is at least `n μ`, where `μ` is the minimum used in the reciprocal-weight estimate.
-/

@[expose] public section
namespace PierceLengthBound.FixedDividend
noncomputable section

/-- The lattice generated by the integer vector `u` and `nℤ³`. -/
def crossSpanLattice (n : ℕ) (u : Fin 3 → ℤ) : AddSubgroup (Fin 3 → ℤ) where
  carrier := {v | ∃ a : ℤ, ∃ z : Fin 3 → ℤ, ∀ j, v j = a * u j + n * z j}
  zero_mem' := ⟨0, 0, by simp⟩
  add_mem' := by
    rintro x y ⟨a, z, hx⟩ ⟨b, w, hy⟩
    refine ⟨a + b, z + w, fun j => ?_⟩
    simp only [Pi.add_apply, hx, hy]
    ring
  neg_mem' := by
    rintro x ⟨a, z, hx⟩
    refine ⟨-a, -z, fun j => ?_⟩
    simp only [Pi.neg_apply, hx]
    ring

lemma mem_crossSpanLattice_of_dvd {n : ℕ} (u : Fin 3 → ℤ) {v : Fin 3 → ℤ}
    (hv : ∀ j, (n : ℤ) ∣ v j) : v ∈ crossSpanLattice n u := by
  choose z hz using hv
  exact ⟨0, z, by simpa using hz⟩

/-- The primitive cross-congruence has the exact integer-lattice description used in the
pattern-counting argument. -/
theorem primitive_cross_congruence_iff {n : ℕ} (hn : 0 < n) {u v : Fin 3 → ℤ}
    (hu : gcd4 n u = 1) :
    (∀ j, (n : ℤ) ∣ cross3 u v j) ↔ v ∈ crossSpanLattice n u := by
  constructor
  · intro hcross
    obtain ⟨r, w, a, _, hnr, huw, hv⟩ := cross_cong hn hcross
    have hrn : r = (n : ℤ) := by simpa only [hu, Nat.cast_one, one_mul] using hnr.symm
    have hwu : w = u := by
      funext j
      simpa only [hu, Nat.cast_one, one_mul] using (huw j).symm
    rw [hrn, hwu] at hv
    choose z hz using hv
    exact ⟨a, z, fun j => by linarith [hz j]⟩
  · rintro ⟨a, z, hv⟩ j
    refine ⟨cross3 u z j, ?_⟩
    fin_cases j <;> simp [cross3, hv] <;> ring

/-- The least sup norm is bounded by the Euclidean norm of every nonzero normal vector. -/
lemma normalShortR_sq_le_nrm3 {n : ℕ} (hn : 0 < n) {u z : Fin 3 → ℤ}
    (hd : (n : ℤ) ∣ dot3 u z) (hz : z ≠ 0) :
    (normalShortR n u : ℤ) ^ 2 ≤ nrm3 z := by
  have hμ : 1 ≤ normalShortR n u := (normalShortR_spec hn u).1
  have hlarge : ∃ j, (normalShortR n u : ℤ) ≤ |z j| := by
    by_contra h
    push Not at h
    have hs : NormalHasShort n u (normalShortR n u - 1) := ⟨z, hd, hz, fun j => by
      have := h j
      push_cast [hμ]
      omega⟩
    exact Nat.notMem_of_lt_sInf (s := {R : ℕ | NormalHasShort n u R})
      (m := normalShortR n u - 1) (by change _ < normalShortR n u; omega) hs
  obtain ⟨j, hj⟩ := hlarge
  have hsq : (normalShortR n u : ℤ) ^ 2 ≤ z j ^ 2 := by
    rw [← sq_abs (z j)]
    exact pow_le_pow_left₀ (by positivity) hj 2
  have hcoord : z j ^ 2 ≤ nrm3 z := by
    unfold nrm3 dot3
    fin_cases j <;> simp <;> nlinarith [sq_nonneg (z 0), sq_nonneg (z 1), sq_nonneg (z 2)]
  exact hsq.trans hcoord

/-- The cross product of two lattice vectors is `n` times a normal-lattice vector. -/
theorem crossSpanLattice_cross_normal {n : ℕ} {u x y : Fin 3 → ℤ}
    (hx : x ∈ crossSpanLattice n u) (hy : y ∈ crossSpanLattice n u) :
    ∃ z : Fin 3 → ℤ, (∀ j, cross3 x y j = n * z j) ∧ (n : ℤ) ∣ dot3 u z := by
  obtain ⟨a, v, hv⟩ := hx
  obtain ⟨b, w, hw⟩ := hy
  let z := fun j => a * cross3 u w j + b * cross3 v u j + n * cross3 v w j
  refine ⟨z, ?_, ⟨dot3 u (cross3 v w), ?_⟩⟩
  · intro j
    fin_cases j <;> simp [z, cross3, hv, hw] <;> ring
  · simp only [z, dot3, cross3_zero, cross3_one, cross3_two]
    ring

lemma nrm3_cross3 (x y : Fin 3 → ℤ) :
    nrm3 (cross3 x y) = nrm3 x * nrm3 y - dot3 x y ^ 2 := by
  simp only [nrm3, dot3, cross3_zero, cross3_one, cross3_two]
  ring

/-- Every independent pair in `ℤu + nℤ³` has product of lengths at least `n μ`.
This replaces the Gram--Schmidt argument in the polynomial-fiber estimate. -/
theorem crossSpanLattice_pair_norm_bound {n : ℕ} (hn : 0 < n) {u x y : Fin 3 → ℤ}
    (hx : x ∈ crossSpanLattice n u) (hy : y ∈ crossSpanLattice n u)
    (hxy : cross3 x y ≠ 0) :
    (n : ℤ) ^ 2 * (normalShortR n u : ℤ) ^ 2 ≤ nrm3 x * nrm3 y := by
  obtain ⟨z, hcz, hdz⟩ := crossSpanLattice_cross_normal hx hy
  have hz : z ≠ 0 := by
    rintro rfl
    apply hxy
    funext j
    simpa using hcz j
  have hscale : nrm3 (cross3 x y) = (n : ℤ) ^ 2 * nrm3 z := by
    simp only [nrm3, dot3, hcz]
    ring
  calc (n : ℤ) ^ 2 * (normalShortR n u : ℤ) ^ 2
      ≤ (n : ℤ) ^ 2 * nrm3 z :=
        mul_le_mul_of_nonneg_left (normalShortR_sq_le_nrm3 hn hdz hz) (sq_nonneg _)
    _ = nrm3 (cross3 x y) := hscale.symm
    _ ≤ nrm3 x * nrm3 y := by rw [nrm3_cross3]; exact sub_le_self _ (sq_nonneg _)

end
end PierceLengthBound.FixedDividend
