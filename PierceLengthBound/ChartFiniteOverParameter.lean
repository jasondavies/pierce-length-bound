module

public import PierceLengthBound.FixedDividendRationalChart

/-! The entire infinity chart, not only its fiber at infinity, is finite over
the algebra generated by the infinity coordinate. This provides a finite
algebra model for constructing its normalization. -/

@[expose] public section
namespace PierceLengthBound.FixedDividend
noncomputable section

/-- Eventual generation in the original degree filtration gives module
finiteness of the inverse-coordinate chart over its parameter algebra. -/
theorem projectiveChart_finite_over_parameter {K σ F : Type*}
    [Field K] [Field F] [Algebra K F] [Finite σ]
    (I : Ideal (MvPolynomial σ K))
    (ι : (MvPolynomial σ K ⧸ I) →ₐ[K] F)
    (l : MvPolynomial σ K ⧸ I) (hl : l ∈ filteredCoordinateSpace I 1) (hl0 : ι l ≠ 0)
    {N : ℕ} (hspan : ∀ n ≥ N, filteredCoordinateSpace I (n + 1) ⊔
      (filteredCoordinateSpace I (n + 1)).map (LinearMap.mulLeft K l) =
        filteredCoordinateSpace I (n + 2)) :
    Module.Finite (Algebra.adjoin K {chartInfinityCoordinate I ι l})
      (projectiveChart I ι l) := by
  let S := projectiveChart I ι l
  let w := chartInfinityCoordinate I ι l
  let T := Algebra.adjoin K ({w} : Set S)
  let U := (chartMonomialMap I ι l (N + 1)).range
  let V := Submodule.span T (U : Set S)
  have hfg : V.FG := (Module.Finite.iff_fg.mp (inferInstance : Module.Finite K U)).span
  have hmono := projectiveChartPiece_mono I ι l hl hl0
  have hmem (n : ℕ) (a : filteredCoordinateSpace I n) : chartMonomialMap I ι l n a ∈ V := by
    induction n using Nat.strong_induction_on with
    | h n ih =>
      by_cases hn : n ≤ N + 1
      · have hm := hmono hn ((mem_projectiveChartPiece I ι l n _).mpr ⟨a, a.property, rfl⟩)
        obtain ⟨b, hb, he⟩ := (mem_projectiveChartPiece I ι l (N + 1) _).mp hm
        apply Submodule.subset_span
        exact ⟨⟨b, hb⟩, Subtype.ext he⟩
      · obtain ⟨m, rfl⟩ : ∃ m, n = m + 2 := ⟨n - 2, by omega⟩
        have ha : (a : MvPolynomial σ K ⧸ I) ∈ filteredCoordinateSpace I (m + 1) ⊔
            (filteredCoordinateSpace I (m + 1)).map (LinearMap.mulLeft K l) := by
          rw [hspan m (by omega)]
          exact a.property
        obtain ⟨b, hb, z, ⟨c, hc, hcz⟩, hsum⟩ := Submodule.mem_sup.mp ha
        have habc : (a : MvPolynomial σ K ⧸ I) = b + l * c := by
          simpa only [← hcz, LinearMap.mulLeft_apply] using hsum.symm
        let B := chartMonomialMap I ι l (m + 1) ⟨b, hb⟩
        let C := chartMonomialMap I ι l (m + 1) ⟨c, hc⟩
        have heq : chartMonomialMap I ι l (m + 2) a = w * B + C := by
          apply Subtype.ext
          change ι (a : MvPolynomial σ K ⧸ I) * (ι l)⁻¹ ^ (m + 2) =
            (ι l)⁻¹ * (ι b * (ι l)⁻¹ ^ (m + 1)) + ι c * (ι l)⁻¹ ^ (m + 1)
          rw [habc, map_add, map_mul, show m + 2 = (m + 1) + 1 by omega, pow_succ]
          field_simp
        rw [heq]
        apply V.add_mem
        · exact V.smul_mem (⟨w, Algebra.subset_adjoin (Set.mem_singleton w)⟩ : T)
            (ih (m + 1) (by omega) ⟨b, hb⟩)
        · exact ih (m + 1) (by omega) ⟨c, hc⟩
  have htop : V = ⊤ := by
    apply top_unique
    intro x _
    obtain ⟨n, a, ha, he⟩ := (mem_projectiveChart_iff I ι l hl hl0 (x : F)).mp x.property
    have hx : chartMonomialMap I ι l n ⟨a, ha⟩ = x := Subtype.ext he
    rw [← hx]
    exact hmem n ⟨a, ha⟩
  exact ⟨htop ▸ hfg⟩

/-- Actual nonexceptional components satisfy the required eventual generation;
the chart parameter algebra therefore has a finite chart module. -/
theorem nonexceptional_chart_finite_over_parameter
    {ρ u v : ℚ} (hρ : 0 < ρ) (hu : 0 < u) (hv : v < 0)
    (hne : NonexceptionalPattern (ρ : ℝ) (u : ℝ) (v : ℝ)) (ρ' u' v' A a : ℚ) (ha : a ≠ 0)
    (I : Ideal (MvPolynomial (Fin 3) ℚ))
    (hf : curveQuadratic ρ u v ρ' u' v' ∈ I)
    (hg : curveEquation ρ u v ρ' u' v' A a ∈ I)
    {F : Type*} [Field F] [Algebra ℚ F]
    (ι : (MvPolynomial (Fin 3) ℚ ⧸ I) →ₐ[ℚ] F) (hι : Function.Injective ι)
    {d N : ℕ} {b : ℤ} (hd : 0 < d)
    (hdegree : ∀ n ≥ N,
      (Module.finrank ℚ (filteredCoordinateSpace I n) : ℤ) = (d : ℤ) * n + b) :
    Module.Finite
      (Algebra.adjoin ℚ {chartInfinityCoordinate I ι (Ideal.Quotient.mk I (MvPolynomial.X 0))})
      (projectiveChart I ι (Ideal.Quotient.mk I (MvPolynomial.X 0))) := by
  obtain ⟨M, hs⟩ := rational_nonexceptional_eventual_first_node_generation
    hρ hu hv hne ρ' u' v' A a ha I hf hg
  have hl : ι (Ideal.Quotient.mk I (MvPolynomial.X 0)) ≠ 0 := by
    intro hh
    apply first_node_ne_zero_of_generation I hd hdegree hs
    exact hι (by simpa using hh)
  exact projectiveChart_finite_over_parameter I ι _
    ⟨MvPolynomial.X 0, by simp [MvPolynomial.mem_restrictTotalDegree], rfl⟩ hl hs

end
end PierceLengthBound.FixedDividend
