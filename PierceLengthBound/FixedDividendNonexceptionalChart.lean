module

public import PierceLengthBound.FixedDividendEventualGeneration
public import PierceLengthBound.FixedDividendComponents

/-!
# The actual nonexceptional first-node chart

The fixed-dividend equations force eventual generation by the first node.
Consequently the finite infinity section in that chart has dimension equal to
the affine Hilbert degree. The generation premise in the abstract chart theorem
is discharged using the actual leading equations and the Nullstellensatz.
-/

@[expose] public section
namespace PierceLengthBound.FixedDividend
noncomputable section
open MvPolynomial

/-- Every ideal containing the nonexceptional fixed-dividend equations has
its high-degree infinity pieces generated by the first node. -/
theorem nonexceptional_eventual_first_node_generation
    {ρ u v : ℝ} (hρ : 0 < ρ) (hu : 0 < u) (hv : v < 0)
    (hne : NonexceptionalPattern ρ u v) (ρ' u' v' A a : ℂ) (ha : a ≠ 0)
    (I : Ideal (MvPolynomial (Fin 3) ℂ))
    (hf : curveQuadratic (ρ : ℂ) u v ρ' u' v' ∈ I)
    (hg : curveEquation (ρ : ℂ) u v ρ' u' v' A a ∈ I) :
    ∃ M : ℕ, ∀ n ≥ M, filteredCoordinateSpace I (n + 1) ⊔
        (filteredCoordinateSpace I (n + 1)).map
          (LinearMap.mulLeft ℂ (Ideal.Quotient.mk I (X 0))) =
      filteredCoordinateSpace I (n + 2) := by
  obtain ⟨N, hN, hp⟩ := nonexceptional_infinity_coordinate_powers hρ hu hv hne
  let M := max N 12
  have hNM : N ≤ M := le_max_left _ _
  have h12M : 12 ≤ M := le_max_right _ _
  let f := curveQuadratic (ρ : ℂ) u v ρ' u' v'
  let g := C (-a⁻¹) * curveEquation (ρ : ℂ) u v ρ' u' v' A a
  have hgI : g ∈ I := I.mul_mem_left _ hg
  have hgd : g.totalDegree ≤ 12 := by
    apply (totalDegree_mul _ _).trans
    simpa only [totalDegree_C, zero_add] using
      curveEquation_degree_le (ρ : ℂ) u v ρ' u' v' A a
  have hgt : homogeneousComponent 12 g =
      leadingCubic (-(ρ : ℂ) - u) ((u : ℂ) - v) ((v : ℂ) - 1) ^ 4 := by
    dsimp [g]
    rw [homogeneousComponent_C_mul, curveEquation_top_component]
    simp only [← map_neg, ← mul_assoc, ← map_mul]
    simp [ha]
  have hpow : ∀ j : Fin 3, ∃ r s : MvPolynomial (Fin 3) ℂ,
      r.totalDegree ≤ M - 1 ∧ s.totalDegree ≤ M - 1 ∧
      Ideal.Quotient.mk I (X j ^ M) = Ideal.Quotient.mk I r +
        Ideal.Quotient.mk I (X 0) * Ideal.Quotient.mk I s := by
    intro j
    have hm := (infinityBoundaryIdeal (ρ : ℂ) (u : ℂ) (v : ℂ)).mul_mem_left
      ((X j : MvPolynomial (Fin 3) ℂ) ^ (M - N)) (hp j)
    rw [← pow_add, Nat.sub_add_cancel hNM] at hm
    apply lift_coordinate_power_certificate I hf hgI (by decide : 0 < 2)
      (by decide : 0 < 12) (curveQuadratic_degree_le_two _ _ _ _ _ _) hgd
      (by omega) h12M (by omega) j 0
    simpa only [curveQuadratic_top_component, hgt, infinityBoundaryIdeal] using hm
  exact ⟨3 * M, eventual_generation_of_coordinate_power_reductions I 0 (by omega) hpow⟩

/-- Positive Hilbert slope and eventual generation force the chart coordinate
itself to be nonzero in the affine coordinate ring. -/
theorem first_node_ne_zero_of_generation {K : Type*} [Field K]
    (I : Ideal (MvPolynomial (Fin 3) K)) {d N M : ℕ} {b : ℤ}
    (hd : 0 < d)
    (hdegree : ∀ n ≥ N,
      (Module.finrank K (filteredCoordinateSpace I n) : ℤ) = (d : ℤ) * n + b)
    (hspan : ∀ n ≥ M, filteredCoordinateSpace I (n + 1) ⊔
        (filteredCoordinateSpace I (n + 1)).map
          (LinearMap.mulLeft K (Ideal.Quotient.mk I (X 0))) =
      filteredCoordinateSpace I (n + 2)) :
    Ideal.Quotient.mk I (X 0) ≠ 0 := by
  intro hz
  let n := max N M
  have hnN : N ≤ n := le_max_left _ _
  have hnM : M ≤ n := le_max_right _ _
  have hs := hspan n hnM
  rw [hz] at hs
  have hzL : LinearMap.mulLeft K (0 : MvPolynomial (Fin 3) K ⧸ I) = 0 := by
    ext x
    simp
  rw [hzL, Submodule.map_zero, sup_bot_eq] at hs
  have he := congrArg
    (fun V : Submodule K (MvPolynomial (Fin 3) K ⧸ I) => (Module.finrank K V : ℤ)) hs
  have h1 := hdegree (n + 1) (by omega)
  have h2 := hdegree (n + 2) (by omega)
  rw [h1, h2] at he
  push_cast at he
  have : (0 : ℤ) < d := by exact_mod_cast hd
  nlinarith

/-- The genuine infinity section of a nonexceptional component is finite and
has its certified Hilbert degree as vector-space dimension. -/
theorem nonexceptional_chart_infinity_dimension
    {ρ u v : ℝ} (hρ : 0 < ρ) (hu : 0 < u) (hv : v < 0)
    (hne : NonexceptionalPattern ρ u v) (ρ' u' v' A a : ℂ) (ha : a ≠ 0)
    (I : Ideal (MvPolynomial (Fin 3) ℂ)) [I.IsPrime]
    (hf : curveQuadratic (ρ : ℂ) u v ρ' u' v' ∈ I)
    (hg : curveEquation (ρ : ℂ) u v ρ' u' v' A a ∈ I)
    {F : Type*} [Field F] [Algebra ℂ F]
    (ι : (MvPolynomial (Fin 3) ℂ ⧸ I) →ₐ[ℂ] F) (hι : Function.Injective ι)
    {d N : ℕ} {b : ℤ} (hd : 0 < d)
    (hdegree : ∀ n ≥ N,
      (Module.finrank ℂ (filteredCoordinateSpace I n) : ℤ) = (d : ℤ) * n + b) :
    Module.Finite ℂ (projectiveChart I ι (Ideal.Quotient.mk I (X 0)) ⧸
      chartInfinityIdeal I ι (Ideal.Quotient.mk I (X 0))) ∧
    Module.finrank ℂ (projectiveChart I ι (Ideal.Quotient.mk I (X 0)) ⧸
      chartInfinityIdeal I ι (Ideal.Quotient.mk I (X 0))) = d := by
  obtain ⟨M, hspan⟩ := nonexceptional_eventual_first_node_generation
    hρ hu hv hne ρ' u' v' A a ha I hf hg
  have hl0 := first_node_ne_zero_of_generation I hd hdegree hspan
  have hl : Ideal.Quotient.mk I (X 0) ∈ filteredCoordinateSpace I 1 :=
    ⟨X 0, by simp [mem_restrictTotalDegree], rfl⟩
  apply chart_infinity_dimension_eq_degree I ι hι _ hl
    (fun hh => hl0 (hι (by simpa using hh))) (N := max N M)
  · intro n hn
    exact hdegree n ((le_max_left _ _).trans hn)
  · intro n hn
    exact hspan n ((le_max_right _ _).trans hn)

end
end PierceLengthBound.FixedDividend
