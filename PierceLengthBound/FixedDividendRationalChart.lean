module

public import PierceLengthBound.FixedDividendRationalInfinity

/-!
# The actual rational nonexceptional first-node chart

The fixed-dividend equations force eventual generation by the first node.
Consequently the finite infinity section in that chart has dimension equal to
the affine Hilbert degree. The generation premise in the abstract chart theorem
is discharged using the actual leading equations and the Nullstellensatz.
-/

@[expose] public section
namespace PierceLengthBound.FixedDividend
noncomputable section
open MvPolynomial

/-- Every ideal containing the nonexceptional fixed-dividend equations has
its high-degree infinity pieces generated by the first node. -/
theorem rational_nonexceptional_eventual_first_node_generation
    {ρ u v : ℚ} (hρ : 0 < ρ) (hu : 0 < u) (hv : v < 0)
    (hne : NonexceptionalPattern (ρ : ℝ) (u : ℝ) (v : ℝ)) (ρ' u' v' A a : ℚ) (ha : a ≠ 0)
    (I : Ideal (MvPolynomial (Fin 3) ℚ))
    (hf : curveQuadratic (ρ : ℚ) u v ρ' u' v' ∈ I)
    (hg : curveEquation (ρ : ℚ) u v ρ' u' v' A a ∈ I) :
    ∃ M : ℕ, ∀ n ≥ M, filteredCoordinateSpace I (n + 1) ⊔
        (filteredCoordinateSpace I (n + 1)).map
          (LinearMap.mulLeft ℚ (Ideal.Quotient.mk I (X 0))) =
      filteredCoordinateSpace I (n + 2) := by
  obtain ⟨N, hN, hp⟩ := rational_nonexceptional_infinity_coordinate_powers hρ hu hv hne
  let M := max N 12
  have hNM : N ≤ M := le_max_left _ _
  have h12M : 12 ≤ M := le_max_right _ _
  let f := curveQuadratic (ρ : ℚ) u v ρ' u' v'
  let g := C (-a⁻¹) * curveEquation (ρ : ℚ) u v ρ' u' v' A a
  have hgI : g ∈ I := I.mul_mem_left _ hg
  have hgd : g.totalDegree ≤ 12 := by
    apply (totalDegree_mul _ _).trans
    simpa only [totalDegree_C, zero_add] using
      curveEquation_degree_le (ρ : ℚ) u v ρ' u' v' A a
  have hgt : homogeneousComponent 12 g =
      leadingCubic (-(ρ : ℚ) - u) ((u : ℚ) - v) ((v : ℚ) - 1) ^ 4 := by
    dsimp [g]
    rw [homogeneousComponent_C_mul, curveEquation_top_component]
    simp only [← map_neg, ← mul_assoc, ← map_mul]
    simp [ha]
  have hpow : ∀ j : Fin 3, ∃ r s : MvPolynomial (Fin 3) ℚ,
      r.totalDegree ≤ M - 1 ∧ s.totalDegree ≤ M - 1 ∧
      Ideal.Quotient.mk I (X j ^ M) = Ideal.Quotient.mk I r +
        Ideal.Quotient.mk I (X 0) * Ideal.Quotient.mk I s := by
    intro j
    have hm := (rationalInfinityBoundaryIdeal (ρ : ℚ) (u : ℚ) (v : ℚ)).mul_mem_left
      ((X j : MvPolynomial (Fin 3) ℚ) ^ (M - N)) (hp j)
    rw [← pow_add, Nat.sub_add_cancel hNM] at hm
    apply lift_coordinate_power_certificate I hf hgI (by decide : 0 < 2)
      (by decide : 0 < 12) (curveQuadratic_degree_le_two _ _ _ _ _ _) hgd
      (by omega) h12M (by omega) j 0
    simpa only [curveQuadratic_top_component, hgt, rationalInfinityBoundaryIdeal] using hm
  exact ⟨3 * M, eventual_generation_of_coordinate_power_reductions I 0 (by omega) hpow⟩

/-- The genuine infinity section of a nonexceptional component is finite and
has its certified Hilbert degree as vector-space dimension. -/
theorem rational_nonexceptional_chart_infinity_dimension
    {ρ u v : ℚ} (hρ : 0 < ρ) (hu : 0 < u) (hv : v < 0)
    (hne : NonexceptionalPattern (ρ : ℝ) (u : ℝ) (v : ℝ)) (ρ' u' v' A a : ℚ) (ha : a ≠ 0)
    (I : Ideal (MvPolynomial (Fin 3) ℚ)) [I.IsPrime]
    (hf : curveQuadratic (ρ : ℚ) u v ρ' u' v' ∈ I)
    (hg : curveEquation (ρ : ℚ) u v ρ' u' v' A a ∈ I)
    {F : Type*} [Field F] [Algebra ℚ F]
    (ι : (MvPolynomial (Fin 3) ℚ ⧸ I) →ₐ[ℚ] F) (hι : Function.Injective ι)
    {d N : ℕ} {b : ℤ} (hd : 0 < d)
    (hdegree : ∀ n ≥ N,
      (Module.finrank ℚ (filteredCoordinateSpace I n) : ℤ) = (d : ℤ) * n + b) :
    Module.Finite ℚ (projectiveChart I ι (Ideal.Quotient.mk I (X 0)) ⧸
      chartInfinityIdeal I ι (Ideal.Quotient.mk I (X 0))) ∧
    Module.finrank ℚ (projectiveChart I ι (Ideal.Quotient.mk I (X 0)) ⧸
      chartInfinityIdeal I ι (Ideal.Quotient.mk I (X 0))) = d := by
  obtain ⟨M, hspan⟩ := rational_nonexceptional_eventual_first_node_generation
    hρ hu hv hne ρ' u' v' A a ha I hf hg
  have hl0 := first_node_ne_zero_of_generation I hd hdegree hspan
  have hl : Ideal.Quotient.mk I (X 0) ∈ filteredCoordinateSpace I 1 :=
    ⟨X 0, by simp [mem_restrictTotalDegree], rfl⟩
  apply chart_infinity_dimension_eq_degree I ι hι _ hl
    (fun hh => hl0 (hι (by simpa using hh))) (N := max N M)
  · intro n hn
    exact hdegree n ((le_max_left _ _).trans hn)
  · intro n hn
    exact hspan n ((le_max_right _ _).trans hn)

end
end PierceLengthBound.FixedDividend
