module

public import PierceLengthBound.FixedDividendHomogeneousLift
public import PierceLengthBound.FixedDividendChartSection

/-!
# Coordinate-power reductions imply eventual generation

Once each coordinate power reduces to a lower-degree term plus the chart
coordinate times another lower-degree term, every sufficiently large homogeneous
piece is generated by that coordinate. This is a finite monomial pigeonhole
argument, including all nonhomogeneous representatives in the affine quotient.
-/

@[expose] public section
namespace PierceLengthBound.FixedDividend
noncomputable section
open MvPolynomial

lemma three_variable_large_exponent (d : Fin 3 →₀ ℕ) {N : ℕ} (_hN : 0 < N)
    (hd : 3 * N ≤ d.degree) : ∃ j, N ≤ d j := by
  by_contra h
  push Not at h
  have h0 := h 0
  have h1 := h 1
  have h2 := h 2
  have hs := Finsupp.degree_eq_sum d
  simp only [Fin.sum_univ_succ] at hs
  norm_num at hs
  omega

/-- Power reductions suffice for eventual generation by one linear coordinate. -/
theorem eventual_generation_of_coordinate_power_reductions {K : Type*} [Field K]
    (I : Ideal (MvPolynomial (Fin 3) K)) (k : Fin 3) {N : ℕ} (hN : 0 < N)
    (hpow : ∀ j : Fin 3, ∃ r s : MvPolynomial (Fin 3) K,
      r.totalDegree ≤ N - 1 ∧ s.totalDegree ≤ N - 1 ∧
      Ideal.Quotient.mk I (X j ^ N) = Ideal.Quotient.mk I r +
        Ideal.Quotient.mk I (X k) * Ideal.Quotient.mk I s) :
    ∀ n ≥ 3 * N, filteredCoordinateSpace I (n + 1) ⊔
        (filteredCoordinateSpace I (n + 1)).map
          (LinearMap.mulLeft K (Ideal.Quotient.mk I (X k))) =
      filteredCoordinateSpace I (n + 2) := by
  classical
  intro n hn
  let l := Ideal.Quotient.mk I (X k)
  have hl : l ∈ filteredCoordinateSpace I 1 := by
    exact ⟨X k, by simp [mem_restrictTotalDegree], rfl⟩
  apply le_antisymm
  · apply sup_le
    · exact filteredCoordinateSpace_mono I (by omega)
    · rintro x ⟨y, hy, rfl⟩
      simpa only [LinearMap.mulLeft_apply, show 1 + (n + 1) = n + 2 by omega] using
        filteredCoordinateSpace_mul_mem I hl hy
  · have hmono (d : Fin 3 →₀ ℕ) (c : K) (hd : d.degree ≤ n + 2) :
        Ideal.Quotient.mk I (monomial d c) ∈ filteredCoordinateSpace I (n + 1) ⊔
          (filteredCoordinateSpace I (n + 1)).map (LinearMap.mulLeft K l) := by
      by_cases hsmall : d.degree ≤ n + 1
      · apply (le_sup_left : filteredCoordinateSpace I (n + 1) ≤ _)
        refine ⟨monomial d c, ?_, rfl⟩
        change monomial d c ∈ restrictTotalDegree (Fin 3) K (n + 1)
        rw [mem_restrictTotalDegree]
        exact (totalDegree_monomial_le d c).trans hsmall
      have heq : d.degree = n + 2 := by omega
      obtain ⟨j, hj⟩ := three_variable_large_exponent d hN (by omega)
      obtain ⟨r, s, hr, hs, hrel⟩ := hpow j
      let e := d - Finsupp.single j N
      have he : e + Finsupp.single j N = d :=
        tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr hj)
      have hedeg : e.degree + N = d.degree := by
        simpa only [map_add, Finsupp.degree_single] using congrArg Finsupp.degree he
      have hm : monomial d c = monomial e c * X j ^ N := by
        rw [X_pow_eq_monomial, monomial_mul_monomial, mul_one, he]
      have hr' : (monomial e c * r).totalDegree ≤ n + 1 := by
        apply (totalDegree_mul _ _).trans
        have hme := totalDegree_monomial_le e c
        change (monomial e c).totalDegree ≤ e.degree at hme
        omega
      have hs' : (monomial e c * s).totalDegree ≤ n + 1 := by
        apply (totalDegree_mul _ _).trans
        have hme := totalDegree_monomial_le e c
        change (monomial e c).totalDegree ≤ e.degree at hme
        omega
      rw [hm, map_mul, hrel, mul_add]
      apply Submodule.add_mem
      · apply (le_sup_left : filteredCoordinateSpace I (n + 1) ≤ _)
        refine ⟨monomial e c * r, (mem_restrictTotalDegree _ _ _).mpr hr', ?_⟩
        simp
      · apply (le_sup_right : (filteredCoordinateSpace I (n + 1)).map
          (LinearMap.mulLeft K l) ≤ _)
        refine ⟨Ideal.Quotient.mk I (monomial e c * s),
          ⟨monomial e c * s, (mem_restrictTotalDegree _ _ _).mpr hs', rfl⟩, ?_⟩
        simp only [LinearMap.mulLeft_apply, map_mul, l]
        ring
    intro x hx
    obtain ⟨f, hf, rfl⟩ := hx
    change f ∈ restrictTotalDegree (Fin 3) K (n + 2) at hf
    rw [mem_restrictTotalDegree] at hf
    change Ideal.Quotient.mk I f ∈ _
    rw [← f.support_sum_monomial_coeff, map_sum]
    apply Submodule.sum_mem
    intro d hd
    apply hmono d (f.coeff d)
    exact (Finset.le_sup hd).trans hf

end
end PierceLengthBound.FixedDividend
