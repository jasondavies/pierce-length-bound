module

public import PierceLengthBound.FixedDividendChartSection
public import Mathlib.RingTheory.Localization.FractionRing

/-! The original affine coordinate ring and its projective chart have the
same function field. This identifies normalization branch valuations with
valuations of the rational functions used in the joint lift. -/

@[expose] public section
namespace PierceLengthBound.FixedDividend
noncomputable section

/-- Every original polynomial function is a quotient of two chart functions. -/
theorem original_coordinate_as_chart_fraction {K σ F : Type*}
    [Field K] [Field F] [Algebra K F]
    (I : Ideal (MvPolynomial σ K)) (ι : (MvPolynomial σ K ⧸ I) →ₐ[K] F)
    (l : MvPolynomial σ K ⧸ I) (hl0 : ι l ≠ 0) (a : MvPolynomial σ K ⧸ I) :
    ∃ x y : projectiveChart I ι l, ι a = (x : F) / (y : F) := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
  have hf : Ideal.Quotient.mk I f ∈ filteredCoordinateSpace I f.totalDegree :=
    ⟨f, (MvPolynomial.mem_restrictTotalDegree _ _ _).mpr le_rfl, rfl⟩
  refine ⟨chartMonomialMap I ι l f.totalDegree ⟨_, hf⟩,
    chartInfinityCoordinate I ι l ^ f.totalDegree, ?_⟩
  change ι (Ideal.Quotient.mk I f) =
    (ι (Ideal.Quotient.mk I f) * (ι l)⁻¹ ^ f.totalDegree) / (ι l)⁻¹ ^ f.totalDegree
  rw [mul_div_cancel_right₀ _ (pow_ne_zero _ (inv_ne_zero hl0))]

/-- A field realization generated by fractions of the original coordinates
is also the fraction field of the chart. -/
theorem projectiveChart_isFractionRing {K σ F : Type*}
    [Field K] [Field F] [Algebra K F]
    (I : Ideal (MvPolynomial σ K)) (ι : (MvPolynomial σ K ⧸ I) →ₐ[K] F)
    (l : MvPolynomial σ K ⧸ I) (hl0 : ι l ≠ 0)
    (hfrac : ∀ z : F, ∃ a b : MvPolynomial σ K ⧸ I, z = ι a / ι b) :
    IsFractionRing (projectiveChart I ι l) F := by
  apply IsFractionRing.of_field
  intro z
  obtain ⟨a, b, hz⟩ := hfrac z
  obtain ⟨x, y, ha⟩ := original_coordinate_as_chart_fraction I ι l hl0 a
  obtain ⟨u, v, hb⟩ := original_coordinate_as_chart_fraction I ι l hl0 b
  refine ⟨x * v, y * u, ?_⟩
  change z = ((x : F) * (v : F)) / ((y : F) * (u : F))
  rw [hz, ha, hb]
  simp only [div_eq_mul_inv, mul_inv_rev, inv_inv]
  ring

end
end PierceLengthBound.FixedDividend
